*.py[cod]

# C extensions
*.so

# Packages
*.egg
*.egg-info
dist
build
eggs
parts
bin
var
sdist
develop-eggs
.installed.cfg
lib
lib64


*.nbgrader*

# Installer logs
pip-log.txt

# Unit test / coverage reports
.coverage
.tox
coverage.xml
nosetests.xml
tests/draw_results

# Translations
*.mo

# Mr Developer
.mr.developer.cfg
.project
.pydevproject
.idea/*
.DS_Store

# vi
.*.swp


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
.mypy_cache/*
.idea/*
.vscode/*
hg_old.zip
.cache/*

doc/_static/*
doc/_build/*
c3org/*
animations/*
CLAUDE.md

# quarto build artefacts, all regenerated by ./build.sh
doc/_site/
doc/_freeze
doc/.quarto/
**/*.quarto_ipynb
.venv/

# copied out of the cogent3 doc tree at build time so quarto can resolve
# `bibliography:` against this project, rather than committing a second copy
doc/cogent3.bib

# the assembled site. CNAME and .nojekyll are tracked and are what make GitHub
# Pages serve the apex domain without jekyll, so they are exempted here and
# excluded from build.sh's rsync --delete
docs/*
!docs/CNAME
!docs/.nojekyll

# the cogent3 doc tree composed in by build.sh, and the artefacts generated from
# it -- all regenerated every build, none of it belongs in this repo
doc/doc/
# symlinks build.sh mirrors from the composed tree so the cogent3 pages
# resolve their project-relative reads and writes
doc/app
doc/cookbook
doc/data
doc/draw
doc/examples
doc/objects.json
doc/reference
# quarto writes site_libs/ and *.html next to the source when a single
# file is rendered instead of the project -- that path ignores output-dir
doc/site_libs/
doc/__pycache__
doc/_build
doc/*html